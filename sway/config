# Sway configurations

# Dark mode
set $gnome-schema org.gnome.desktop.interface
exec_always gsettings set $gnome-schema color-scheme 'prefer-dark'
exec_always gsettings set $gnome-schema gtk-theme 'Adwaita-dark'

# Monitor
output LVDS-1 mode 1280x800@60Hz

# Sway spiral layout script (python-i3ipc package required)
set $spiralcmd 'python3 ~/.config/sway/scripts/spiral_layout.py'

# Enable if compatability issues
xwayland enable

# Export display env vars to systemd so portals work
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway GTK_THEME=Adwaita:dark

# Always run scripts
# exec_always killall waybar
# exec_always sleep 0.2; waybar
exec_always waybar
exec_always $spiralcmd
exec_always screenshareFix
exec_always dunst 
# Setting gaps

# Smooth window/layer transitions
animation_duration_ms 250

# Window blur
blur enable
blur_xray disable
blur_passes 3
blur_radius 7
blur_noise 0.03
blur_brightness 1.0
blur_contrast 1.05
blur_saturation 1.15

# Rounded windows
corner_radius 12

# Shadows
shadows enable
shadows_on_csd enable

shadow_blur_radius 18
shadow_color #000000aa
shadow_offset 0 5
shadow_inactive_color #00000066

# Dim inactive windows
default_dim_inactive 0.08

layer_effects "waybar" {
    blur enable;
    blur_xray disable;
    blur_ignore_transparent enable;
    shadows enable;
    corner_radius 10;
}

# SwayNC if you later install/use it
layer_effects "swaync-control-center" {
    blur enable;
    blur_ignore_transparent enable;
    shadows enable;
    corner_radius 12;
}

layer_effects "swaync-notification-window" {
    blur enable;
    blur_ignore_transparent enable;
    shadows enable;
    corner_radius 12;
}

# ============================================================
# LAYOUT
# ============================================================

gaps inner 8
gaps outer 10


titlebar_border_thickness 0
titlebar_padding 4

# Sway borders
default_border pixel 1
default_floating_border pixel 2

client.focused #FFFFFF99 #FFFFFF99 #FFFFFF99
client.unfocused #333333 #5F676A #FFFFFF #484E50 #5F676A

### Variables

# Mod1: Alt
# Mod4: Win
set $mod Mod4

# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l

set $term foot
set $menu wofi
# set $browser 'chromium --force-device-scale-factor=1.25'
set $browser 'qutebrowser --qt-flag disable-features=WebAuth'
# set $browser 'zen-browser'

# Default wallpaper (more resolutions are available in @datadir@/backgrounds/sway/)
output * bg ~/.config/wallpapers/img/Intestellar.jpg fill

# Touchpad tap-to-click
input type:touchpad {
	dwt enabled
	tap enabled
	middle_emulation enabled
}

### Key bindings

# Basics:
    # Start a terminal
    bindsym $mod+Return exec $term

    # Open your browser
    bindsym $mod+b exec $browser

    # Kill focused window
    bindsym $mod+w kill

    # Start your launcher
    bindsym $mod+r exec $menu

    # Lock
    bindsym $mod+Mod1+l exec "swaylock -i $HOME/.config/wallpapers/img/GtfoHD.jpg"

    # Toggle Yambar
    bindsym $mod+semicolon exec killall -SIGUSR1 fwaybar

    # Increase brightness
    bindsym XF86MonBrightnessUp exec 'brightnessctl s +1%'
    bindsym XF86MonBrightnessDown exec 'brightnessctl s 1%-'

		# Volume control
    bindsym XF86AudioRaiseVolume exec 'pactl set-sink-volume 0 +5%'
    bindsym XF86AudioLowerVolume exec 'pactl set-sink-volume 0 -5%'

		# Screenshots and screenrecords
    bindsym Print exec 'screen full'
    bindsym $mod+Print exec 'record start'
    bindsym $mod+Shift+Print exec 'record stop'

		# Music and sound

		bindsym XF86AudioPlay exec 'playerctl play-pause'
		bindsym XF86AudioStop exec 'playerctl stop'
		bindsym XF86AudioPrev exec 'playerctl previous'
		bindsym XF86AudioNext exec 'playerctl next'
		bindsym $mod+m exec 'pactl set-sink-mute @DEFAULT_SINK@ toggle'
		bindsym $mod+space exec 'playerctl play-pause'
		bindsym $mod+n exec 'playerctl next'
		bindsym $mod+p exec 'playerctl previous'

    # Drag floating windows by holding down $mod and left mouse button and resize with right mouse button + $mod.
    floating_modifier $mod normal

    # Reload the configuration file
    bindsym $mod+Shift+semicolon reload

    # Exit sway (logs you out of your Wayland session)
    bindsym $mod+x exec 'swaymsg exit'

		# Launching the Windows VM
    bindsym $mod+v exec 'toggleWin start'
    bindsym $mod+Shift+v exec 'toggleWin shutdown'

		# Launching the file manager
		bindsym $mod+e exec 'GTK_THEME=Adwaita:dark nemo'

# Moving around:
    # Move your focus around
    bindsym $mod+$left focus left
    bindsym $mod+$down focus down
    bindsym $mod+$up focus up
    bindsym $mod+$right focus right

    # Move the focused window with the same, but add Shift
    bindsym $mod+Shift+$left move left
    bindsym $mod+Shift+$down move down
    bindsym $mod+Shift+$up move up
    bindsym $mod+Shift+$right move right
    bindsym $mod+Shift+Left move left
    bindsym $mod+Shift+Down move down
    bindsym $mod+Shift+Up move up
    bindsym $mod+Shift+Right move right

# Workspaces:
    # Switch to workspace
    bindsym $mod+1 workspace number 1
    bindsym $mod+2 workspace number 2
    bindsym $mod+3 workspace number 3
    bindsym $mod+4 workspace number 4
    bindsym $mod+5 workspace number 5
    bindsym $mod+6 workspace number 6
    bindsym $mod+7 workspace number 7
    bindsym $mod+8 workspace number 8
    bindsym $mod+9 workspace number 9
    bindsym $mod+0 workspace number 10
    bindsym $mod+Shift+1 move container to workspace number 1
    bindsym $mod+Shift+2 move container to workspace number 2
    bindsym $mod+Shift+3 move container to workspace number 3
    bindsym $mod+Shift+4 move container to workspace number 4
    bindsym $mod+Shift+5 move container to workspace number 5
    bindsym $mod+Shift+6 move container to workspace number 6
    bindsym $mod+Shift+7 move container to workspace number 7
    bindsym $mod+Shift+8 move container to workspace number 8
    bindsym $mod+Shift+9 move container to workspace number 9
    bindsym $mod+Shift+0 move container to workspace number 10

		# Window resizing
		bindsym $mod+Left resize shrink width 20px
		bindsym $mod+Right resize grow width 20px
		bindsym $mod+Up resize grow height 20px
		bindsym $mod+Down resize shrink height 20px

# Layout:

    # Make the current focus fullscreen
    bindsym $mod+f fullscreen

    # Toggle the current focus between tiling and floating mode
    bindsym $mod+t floating toggle

include @sysconfdir@/sway/config.d/*
